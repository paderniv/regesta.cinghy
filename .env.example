# Connessione SAP di questo progetto, letta da arc-1.
#
# Copia questo file in .env e compila i valori CON IL TUO EDITOR, fuori da una
# sessione Claude. Non dettare mai le credenziali a Claude e non chiedergli di
# scrivere il .env: quello che digiti in sessione finisce nel transcript su disco
# e viene inviato all'API. Il progetto blocca l'accesso al .env con le regole
# Read(.env) e Edit(.env) in .claude/settings.json.
#
# Il file .env non va committato: contiene la password. Il comando
# /abap:setup-project aggiunge la riga .env al .gitignore.
#
# ATTENZIONE: non esportare le variabili di connessione qui sotto nella shell
# o nel profilo utente.
# arc-1 applica la precedenza CLI > ambiente > .env, quindi una variabile
# esportata sovrascrive questo file e fa connettere la sessione a un altro
# sistema SAP senza alcun segnale. Per controllare:  env | grep -E '^SAP_(URL|USER|PASSWORD|CLIENT|LANGUAGE|INSECURE)='

SAP_URL=https://sap.example.local:44300
# Utenza tecnica condivisa con il solo ruolo Z_WB_DISPLAY, in sola lettura.
# Non usare la tua utenza personale: i suoi ruoli si sommano e annullano il limite.
# Il ruolo e' descritto in sap-role/ del repo regesta-claude-marketplace.
SAP_USER=NOME_UTENTE
SAP_PASSWORD=
SAP_CLIENT=100
SAP_LANGUAGE=IT

# Opzionale. Solo per sistemi di test con certificato self-signed.
# SAP_INSECURE=true

# I gate di sicurezza NON si impostano qui. --allow-free-sql e
# --allow-data-preview sono argomenti CLI nel .mcp.json committato, perche'
# sono una decisione di team e devono restare visibili in code review.
# Gli argomenti CLI hanno comunque la precedenza su questo file.

# Deploy di Cinghy (npm run deploy, letto da ui5-deploy.yaml).
CINGHY_SAP_USER=
CINGHY_SAP_PASSWORD=
CINGHY_TRANSPORT=
