{
  "name": "regesta-cinghy",
  "version": "1.0.0",
  "private": true,
  "description": "Cinghy - assistente AI nel Fiori Launchpad (plugin regesta.cinghy)",
  "scripts": {
    "start": "ui5 serve --open test/flpSandbox.html#Shell-home",
    "build": "ui5 build --clean-dest",
    "deploy": "npm run build && deploy -c ui5-deploy.yaml",
    "deploy:test": "npm run build && deploy -c ui5-deploy.yaml --test",
    "undeploy": "undeploy -c ui5-deploy.yaml",
    "icon": "node scripts/genicon.cjs webapp/img/03_analisi_dati_occhiali_ar.svg webapp/CinghyIcon.js",
    "test:e2e": "node --test --test-concurrency=1 \"webapp/test/e2e/*.e2e.mjs\""
  },
  "dependencies": {
    "@ui5/webcomponents": "^2.29.0",
    "@ui5/webcomponents-ai": "^2.29.0",
    "@ui5/webcomponents-icons": "^2.29.0",
    "marked": "^18.2.1"
  },
  "devDependencies": {
    "@sap-ux/deploy-tooling": "^1.0.60",
    "@ui5/cli": "^4.1.0",
    "playwright-core": "^1.65.1",
    "ui5-tooling-modules": "^3.43.2"
  }
}
